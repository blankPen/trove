{
  "name": "trove",
  "version": "0.1.0",
  "description": "AI 资产归档工具 —— 可靠、增量地把本地 AI agent 资产归档到 WebDAV",
  "type": "module",
  "bin": {
    "trove": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "minimatch": "^10.2.6",
    "picocolors": "^1.1.1",
    "webdav": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "webdav-server": "^2.6.0"
  }
}
